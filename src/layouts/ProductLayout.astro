---
/**
 * Every product page, from one template.
 *
 * The five product pages in the handoff were five near-identical files, which
 * is how their crumb numbering drifted out of step with the front page. Here
 * the page is a function of the product entry in src/data/products.ts.
 */
import BaseLayout from './BaseLayout.astro';
import PhotoMat from '../components/PhotoMat.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import { railPosition, productsFactsNote, type Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const page = product.page!;
const crumbLabel = page.crumbLabel ?? railPosition(product.slug) ?? '';
const factsNote = page.factsNote === undefined ? productsFactsNote : page.factsNote;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: product.name,
  serviceType: page.title,
  description: page.metaDescription,
  provider: { '@type': 'Organization', name: 'HEKLA', url: 'https://hekla.cc' },
  areaServed: 'DK',
};
---

<BaseLayout title={page.title} description={page.metaDescription} jsonLd={jsonLd} phoneCta={{ href: page.cta.href, label: page.cta.label.replace(/^\u2192\s*/, '') }}>
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs">
        <a href={page.crumb.href}>{page.crumb.label}</a>
        <span class="label"><span class="tick" aria-hidden="true"></span>{crumbLabel}</span>
      </p>
      <h1 set:html={page.headingHtml} />
      <p class="lead" set:html={page.leadHtml} />
    </div>
  </section>

  <section class="photo-band">
    <div class="wrap">
      <PhotoMat media={page.hero} variant="band" loading="eager" />
    </div>
  </section>

  <FlowDiagram diagram={page.diagram} compact />

  {
    page.examples && (
      <section class="examples" aria-labelledby="examples-heading">
        <div class="wrap">
          <h2 id="examples-heading" data-reveal>{page.examples.heading}</h2>
          <ul class="examples__list">
            {page.examples.items.map((item) => (
              <li data-reveal>{item}</li>
            ))}
          </ul>
          <p class="examples__note" data-reveal>{page.examples.note}</p>
        </div>
      </section>
    )
  }

  <section class="detail">
    <div class="wrap detail__grid">
      <div>
        <h2 data-reveal>What you get</h2>
        <ul class="getlist">
          {
            page.getList.map((item) => (
              <li data-reveal>
                <strong>{item.title}</strong>
                <span>{item.note}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="facts" aria-labelledby="facts-heading" data-reveal>
        <h2 id="facts-heading" class="visually-hidden">Key facts</h2>
        <dl>
          {
            page.facts.map((fact) => (
              <>
                <dt>{fact.term}</dt>
                <dd>{fact.def}</dd>
              </>
            ))
          }
        </dl>
        {page.priceChip && <p class="facts__price"><span class="price-chip"><span>{page.priceChip}</span></span></p>}
        <a href={page.cta.href} class="btn btn--ink facts__cta" data-cta-watch>{page.cta.label}</a>
        {factsNote && <p class="facts__note">{factsNote}</p>}
      </aside>
    </div>
  </section>

  {
    page.runSteps && (
      <section class="runsteps">
        <div class="wrap">
          <h2 data-reveal>{page.runStepsHeading ?? 'How it runs'}</h2>
          <ol class:list={['runsteps__grid', { 'runsteps__grid--five': page.runSteps.length === 5 }]}>
            {page.runSteps.map((step, i) => (
              <li class="runstep" data-reveal>
                <span class="runstep__num" aria-hidden="true">{i + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <section class="limits">
    <div class="wrap">
      <div class="limits__inner" data-reveal>
        <h2>Where it does not fit</h2>
        <p>{page.limits}</p>
      </div>
    </div>
  </section>

  <section class="band-dark" aria-labelledby="closing-heading" data-cta-watch>
    <div class="wrap">
      <h2 id="closing-heading">{page.closing.heading}</h2>
      <a href={page.closing.cta.href} class="btn btn--primary">{page.closing.cta.label}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 72px 0 40px;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 20px;
    max-width: none;
  }

  .crumbs a {
    font-weight: var(--w-structure);
    font-size: 13px;
    text-decoration: none;
    color: var(--ash);
  }

  @media (hover: hover) and (pointer: fine) {
    .crumbs a:hover {
      color: var(--black);
    }
  }

  .page-hero h1 {
    text-wrap: balance;
    font-weight: var(--w-display);
    letter-spacing: var(--track-display);
    font-size: clamp(38px, 5.6vw, 68px);
    line-height: 1.08;
    margin: 8px 0 22px;
  }

  .page-hero .lead {
    font-size: 18px;
  }

  .photo-band {
    padding: 0 0 4px;
  }

  .detail {
    padding: 40px 0 72px;
  }

  /* Illustrative questions. Extra-light display type in quotation marks,
     a hairline between them, and the note saying they are examples. */
  .examples {
    padding: 32px 0 8px;
  }

  .examples h2 {
    font-weight: var(--w-structure);
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: var(--track-label);
    color: var(--ash);
    margin-bottom: 14px;
  }

  .examples__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 40px;
    border-top: 1px solid var(--smoke);
  }

  .examples__list li {
    font-weight: var(--w-display);
    letter-spacing: var(--track-display);
    font-size: clamp(20px, 2.2vw, 26px);
    line-height: 1.25;
    padding: 18px 0;
    border-bottom: 1px solid var(--smoke);
  }

  .examples__list li::before {
    content: '\201C';
  }

  .examples__list li::after {
    content: '\201D';
  }

  .examples__note {
    font-size: 13px;
    color: var(--ash);
    margin-top: 12px;
  }

  .detail__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .detail h2 {
    font-weight: var(--w-structure);
    font-size: 22px;
    letter-spacing: -0.01em;
    margin-bottom: 18px;
  }

  .getlist {
    list-style: none;
  }

  .getlist li {
    padding: 14px 0;
    border-top: 1px solid var(--smoke);
    font-size: 16px;
  }

  .getlist li:first-child {
    border-top: none;
    padding-top: 0;
  }

  .getlist strong {
    font-weight: var(--w-structure);
    display: block;
  }

  .getlist span {
    font-size: 14px;
    color: var(--ash);
  }

  .facts {
    background: var(--white);
    border: 1px solid var(--smoke);
    padding: 28px;
  }

  .facts dl {
    margin-bottom: 22px;
  }

  .facts dt {
    font-weight: var(--w-structure);
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: var(--track-label);
    color: var(--ash);
    margin-top: 16px;
  }

  .facts dt:first-of-type {
    margin-top: 0;
  }

  .facts dd {
    font-size: 16px;
    font-weight: var(--w-structure);
  }

  .facts__price {
    margin-bottom: 18px;
  }

  .facts__cta {
    display: block;
    text-align: center;
  }

  .facts__note {
    font-size: 13px;
    color: var(--ash);
    margin-top: 14px;
  }

  .runsteps {
    padding: 0 0 72px;
  }

  .runsteps h2 {
    font-weight: var(--w-structure);
    font-size: 22px;
    letter-spacing: -0.01em;
    margin-bottom: 26px;
  }

  .runsteps__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    list-style: none;
  }

  /* Five steps read as one row on a wide screen, the way the app's menu does. */
  .runsteps__grid--five {
    grid-template-columns: repeat(5, 1fr);
    gap: 24px;
  }

  .runstep__num {
    font-weight: var(--w-display);
    font-size: 40px;
    letter-spacing: var(--track-display);
    color: var(--ash);
    display: block;
    margin-bottom: 8px;
    line-height: 1.1;
  }

  .runstep h3 {
    font-weight: var(--w-structure);
    font-size: 17px;
    margin-bottom: 6px;
  }

  .runstep p {
    font-size: 15px;
  }

  .limits {
    padding: 0 0 88px;
  }

  .limits__inner {
    border-top: 1px solid var(--smoke);
    padding-top: 28px;
  }

  .limits h2 {
    font-weight: var(--w-structure);
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: var(--track-label);
    color: var(--ash);
    margin-bottom: 10px;
  }

  .limits p {
    font-size: 16px;
  }

  @media (max-width: 1024px) {
    .detail__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .runsteps__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 768px) {
    .examples__list {
      grid-template-columns: 1fr;
    }

    .page-hero {
      padding: 56px 0 32px;
    }
  }

  /* --- Phones -------------------------------------------------------------
     Facts become a two-column table you can scan, the numbered steps put the
     number beside the text, and the gaps between sections close up. */
  @media (max-width: 560px) {
    .page-hero {
      padding: 36px 0 26px;
    }

    .crumbs {
      gap: 14px;
      margin-bottom: 14px;
    }

    .crumbs a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      font-size: 14px;
    }

    .page-hero h1 {
      font-size: clamp(34px, 9.6vw, 40px);
      line-height: 1.1;
      margin: 4px 0 16px;
    }

    .page-hero .lead {
      font-size: 17px;
      line-height: 1.55;
    }

    .examples {
      padding: 28px 0 0;
    }

    .examples__list li {
      font-size: 20px;
      padding: 14px 0;
    }

    .detail {
      padding: 36px 0 48px;
    }

    .detail__grid {
      gap: 32px;
    }

    .detail h2,
    .runsteps h2 {
      font-size: 21px;
      margin-bottom: 14px;
    }

    .getlist li {
      padding: 12px 0;
    }

    .getlist span {
      font-size: 15px;
      line-height: 1.5;
    }

    .facts {
      padding: 6px 20px 20px;
    }

    .facts dl {
      display: grid;
      grid-template-columns: minmax(96px, 36%) 1fr;
      margin-bottom: 18px;
    }

    .facts dt,
    .facts dd {
      padding: 13px 0;
      border-top: 1px solid var(--smoke);
      margin: 0;
    }

    .facts dt {
      padding-right: 12px;
      line-height: 1.5;
    }

    .facts dd {
      font-size: 15px;
      line-height: 1.4;
    }

    .facts dt:first-of-type,
    .facts dt:first-of-type + dd {
      border-top: 0;
    }

    .facts__cta {
      min-height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .runsteps {
      padding: 0 0 48px;
    }

    .runsteps__grid {
      gap: 18px;
    }

    .runstep {
      display: grid;
      grid-template-columns: 40px 1fr;
      column-gap: 12px;
      padding-top: 16px;
      border-top: 1px solid var(--smoke);
    }

    .runstep__num {
      grid-row: span 2;
      font-size: 32px;
      margin: -4px 0 0;
    }

    .limits {
      padding: 0 0 56px;
    }

    .limits__inner {
      padding-top: 22px;
    }
  }
</style>
