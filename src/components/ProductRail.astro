---
/**
 * The front page product rail.
 *
 * A native horizontal scroller with scroll snapping, so it works with a
 * trackpad, a touch drag, the keyboard and no JavaScript at all. The dots and
 * arrows are added by src/scripts/rail.ts on top of that, never instead of it.
 */
import ProductCard from './ProductCard.astro';
import { railProducts } from '../data/products';
---

<div class="rail">
  <!-- No role override here: role="group" on a <ul> strips the list semantics
       and orphans every <li> inside it. A labelled, focusable list is enough. -->
  <ul class="rail__track" data-rail-track tabindex="0" aria-label="Ways to work with us. Scroll sideways.">
    {railProducts.map((product) => <li><ProductCard product={product} /></li>)}
  </ul>

  <div class="rail__controls">
    <div class="rail__dots" data-rail-dots role="tablist" aria-label="Jump to a way of working"></div>
    <div class="rail__arrows">
      <button type="button" class="rail__btn" data-rail-prev aria-label="Previous product">&larr;</button>
      <button type="button" class="rail__btn" data-rail-next aria-label="Next product">&rarr;</button>
    </div>
  </div>
</div>

<script>
  import { initRail } from '../scripts/rail';
  initRail();
</script>

<style>
  .rail {
    position: relative;
  }

  .rail__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 48px) / 3);
    gap: 24px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 2px;
    list-style: none;
  }

  .rail__track::-webkit-scrollbar {
    display: none;
  }

  .rail__track > li {
    scroll-snap-align: start;
    display: flex;
  }

  .rail__track > li > :global(.card) {
    flex: 1;
  }

  .rail__track:focus-visible {
    outline: 2px solid var(--violet);
    outline-offset: 6px;
  }

  .rail__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 26px;
  }

  .rail__dots {
    display: flex;
    gap: 8px;
  }

  .rail__dots :global(.rail__dot) {
    width: 26px;
    height: 3px;
    border: 0;
    padding: 0;
    background: var(--smoke);
    cursor: pointer;
    transition: background var(--t-base);
  }

  .rail__dots :global(.rail__dot[aria-selected='true']) {
    background: var(--violet);
  }

  .rail__arrows {
    display: flex;
    gap: 10px;
  }

  .rail__btn {
    width: 42px;
    height: 42px;
    border: 1px solid var(--black);
    background: transparent;
    color: var(--black);
    font-weight: var(--w-structure);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    transition: background var(--t-fast), color var(--t-fast);
  }

  .rail__btn:hover {
    background: var(--black);
    color: var(--paper);
  }

  @media (max-width: 1024px) {
    .rail__track {
      grid-auto-columns: calc((100% - 24px) / 2);
    }
  }

  @media (max-width: 760px) {
    .rail__track {
      grid-auto-columns: 88%;
    }

    .rail__controls {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
